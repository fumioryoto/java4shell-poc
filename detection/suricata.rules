# Suricata detection rules for CVE-2026-114938 (Java4Shell)
#
# These rules match the malformed Base64 padding pattern characteristic of
# the trigger payload in HTTP contexts where it may be weaponised.
#
# NOTES:
#   - Rule 1000001 matches the 65-byte trigger (JDK 21/25/27) in an Authorization
#     Basic header. The PCRE uses the base64-encoded form of "A"*64+"=".
#     Adjust to the 129-byte form for JDK 17.
#   - Rule 1000002 matches anomalous SAMLResponse length as a heuristic.
#     Tune the {80,} threshold to your environment.
#   - These are starting-point rules; tune classtype, priority, and thresholds
#     before deploying in production.
#
# References:
#   CVE-2026-114938, NVD: https://nvd.nist.gov/vuln/detail/CVE-2026-114938

# ----------------------------------------------------------------------------
# Rule 1: Malformed Base64 trigger in HTTP Authorization Basic header
#
# The 65-byte trigger ("A"*64+"=") base64-encodes to a string starting with
# QUFB... and ending with QUFBPg== or similar. The PCRE below matches the
# specific base64-of-trigger pattern. Update if you switch to the 129-byte
# payload.
# ----------------------------------------------------------------------------
alert http any any -> any any (
    msg:"CVE-2026-114938 Java4Shell - malformed Base64 padding in Authorization Basic header";
    flow:established,to_server;
    content:"Authorization";
    http_header;
    nocase;
    content:"Basic ";
    http_header;
    nocase;
    distance:0;
    pcre:"/Authorization\x3a\s*Basic\s+[A-Za-z0-9+\/]{80,}={1,2}/Hi";
    classtype:attempted-admin;
    priority:1;
    metadata:cve CVE-2026-114938, affected_product OpenJDK, created_at 2026_11_18, deployment perimeter;
    sid:1000001;
    rev:1;
)

# ----------------------------------------------------------------------------
# Rule 2: Malformed Base64 trigger in SAMLResponse parameter
#
# SAML-based SSO endpoints that pass the SAMLResponse through Java's Base64
# decoder are a likely delivery vector. This rule flags anomalously long
# SAMLResponse values as a heuristic.
# ----------------------------------------------------------------------------
alert http any any -> any any (
    msg:"CVE-2026-114938 Java4Shell - anomalous Base64 length in SAMLResponse (possible trigger)";
    flow:established,to_server;
    content:"SAMLResponse";
    http_client_body;
    nocase;
    pcre:"/SAMLResponse\x3d[A-Za-z0-9+\/\%]{80,}/Pi";
    classtype:attempted-admin;
    priority:2;
    metadata:cve CVE-2026-114938, affected_product OpenJDK, created_at 2026_11_18, deployment perimeter;
    sid:1000002;
    rev:1;
)

# ----------------------------------------------------------------------------
# Rule 3: Malformed Base64 trigger in X-API-Key or custom header
#
# Some applications pass user-supplied values to Base64.decode() via custom
# headers. This rule is intentionally broad — tune classtype and priority.
# ----------------------------------------------------------------------------
alert http any any -> any any (
    msg:"CVE-2026-114938 Java4Shell - repeated-A Base64 blob in HTTP header (heuristic)";
    flow:established,to_server;
    pcre:"/\x3a\s*(?:QUFB){10,}/Hi";
    classtype:suspicious-login;
    priority:3;
    metadata:cve CVE-2026-114938, affected_product OpenJDK, created_at 2026_11_18, deployment internal;
    sid:1000003;
    rev:1;
)
